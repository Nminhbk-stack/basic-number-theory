#include <bits/stdc++.h>
using namespace std;

#define ll long long

bool prime(ll n){
    if (n <= 1) return false;
    for(ll i = 2; i <= sqrt(n); i++){
        if (n % i == 0) return false;
    }
    return true;
}

bool nt(ll n){
    ll s = 0;
    while (n != 0){
        ll a = n%10;
        if (a != 2 && a!= 3 && a!= 5 && a!=7) {return false;}
        n /=10;
        s += a;
    }
    if (!prime(s)){
        return false;
    }
    return true;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll a, b; cin >> a >> b;
    ll dem = 0;
    for (ll i = a; i<= b ; i++){
        if ( nt(i) && prime(i)) dem += 1;
    }
    cout << dem;


    return 0;
}
