#include <bits/stdc++.h>
using namespace std;

#define ll long long


int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll n; cin >> n ;
    ll x;
    ll m = pow(10, 9) + 7;
    ll tich = 1;
    for (ll i = 1; i <= n; i ++){
        cin >> x;
        tich *= (x%m)%m;
    }
    cout << tich%m;

    return 0;
}
