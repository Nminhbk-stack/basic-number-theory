#include <bits/stdc++.h>
using namespace std;

#define ll long long

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll n; cin >> n ;
    ll m = 1000000007 ;
    ll s = 1;

    for (ll i = 1; i <= n; i ++){
        s = (s*i)%m;
        cout << s << endl;

    }


    return 0;
}
