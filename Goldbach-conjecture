#include <bits/stdc++.h>
using namespace std;

#define ll long long

bool prime(ll n){
    if (n <= 1) return false;
    for(ll i = 2; i <= sqrt(n); i++){
        if (n % i == 0) return false;
    }
    return true;
}
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

     ll n ; cin >> n ;
     ll x;
     for (ll i = 1; i <= n; i ++){
            cin >> x;
            for (ll j =2; j <= x/2 ; j++){
                 if (prime(j) && (prime(x - j))) cout << j << " " << x-j << endl;
     }
     }
    return 0;
}
